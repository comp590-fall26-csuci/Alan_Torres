[3074.5106379999997, "o", "  lint:fresh\r\n    \u001b[2mmadrun lint:fresh\u001b[22m\r\n  fix:lint\r\n    \u001b[2mmadrun fix:lint\u001b[22m\r\n  lint:stream\r\n    \u001b[2mmadrun lint:stream\u001b[22m\r\n  test:e2e\r\n    \u001b[2mmadrun test:e2e\u001b[22m\r\n"]

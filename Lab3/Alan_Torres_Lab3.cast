[2740.243147, "o", "\u001b[?2004h\u001b]0;vbx-user@COMP590-LABS: ~/Repo/Alan_Torres/Lab3/CloudCMD/man\u0007vbx-user@COMP590-LABS:~/Repo/Alan_Torres/Lab3/CloudCMD/man$ "]

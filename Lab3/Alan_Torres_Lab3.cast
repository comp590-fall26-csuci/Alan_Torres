[4178.830844, "o", "\r\n\u001b[?2004l\r"]
[4178.848491, "o", "#include <stdio.h>\r\n#include \"fibonacci.h\"\r\n\r\nint main(void) {\r\n    int term = 10;\r\n    printf(\"The %dth Fibonacci number is %d\\n\", term, fibonacci(term));\r\n    printf(\"The theoretical Golden Ratio is %f\\n\", golden_ratio_approx(term));\r\n    return 0;\r\n}\r\n"]

[3074.507331, "o", "  build:start:dev\r\n    \u001b[2mmadrun build:start:dev\u001b[22m\r\n"]
[3074.5077269999997, "o", "  lint:all\r\n    \u001b[2mmadrun lint:all\u001b[22m\r\n"]

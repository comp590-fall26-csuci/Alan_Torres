[1105.91865, "o", "\u001b]3008;start=ca443c60-5298-49f9-beb5-be9aab654e5b;machineid=ec269368495231e336f7ec98aad6f10e;user=bandit8;hostname=gibson-0;bootid=b35b0f02-a9a4-4941-884c-a1ce6f7ec2e9;pid=00000000000000000003;type=command;cwd=/home/bandit8\u001b\\"]
[1105.935146, "o", "Report or omit repeated lines.\r\n\r\n\u001b[1m\u001b[4mUsage:\u001b[0m uniq [OPTION]... [INPUT [OUTPUT]]\r\n\r\n\u001b[1m\u001b[4mOptions:\u001b[0m\r\n  \u001b[1m-D\u001b[0m, \u001b[1m--all-repeated\u001b[0m[=<delimit-method>]\r\n          print all duplicate lines. Delimiting is done with blank\r\n          lines. [default: none] [possible values: none, prepend,\r\n          separate]\r\n      \u001b[1m--group\u001b[0m[=<group-method>]\r\n          show all items, separating groups with an empty line.\r\n          [default: separate] [possible values: separate, prepend,\r\n          append, both]\r\n  \u001b[1m-w\u001b[0m, \u001b[1m--check-chars\u001b[0m <N>\r\n          compare no more than N characters in lines\r\n  \u001b[1m-c\u001b[0m, \u001b[1m--count\u001b[0m\r\n          prefix lines by the number of occurrences\r\n  \u001b[1m-i\u001b[0m, \u001b[1m--ignore-case\u001b[0m\r\n          ignore differences in case when comparing\r\n  \u001b[1m-d\u001b[0m, \u001b[1m--repeated\u001b[0m\r\n          only print duplicate lines\r\n  \u001b[1m-s\u001b[0m, \u001b[1m--skip-chars\u001b[0m <N>\r\n          avoid comparing the first N characters\r\n  \u001b[1m-f\u001b[0m, \u001b[1m--skip-fields\u001b[0m <N>\r\n          avoid comparing the first N fields\r\n  \u001b[1m-u\u001b[0m, \u001b[1m--unique\u001b[0m\r\n          only print unique lines\r\n  \u001b[1m-z\u001b[0m, \u001b[1m--zero-terminated\u001b[0m\r\n          end lines with 0 byte, not newline\r\n  \u001b[1m-h\u001b[0m, \u001b[1m--help\u001b[0m\r\n          Print help\r\n  \u001b[1m-V\u001b[0m, \u001b[1m--version\u001b[0m\r\n          Print version\r\n\r\nFilter adjacent matching lines from INPUT (or standard input),\r\nwriting to OUTPUT (or standard output).\r\n\r\nNote: uniq does not detect repeated lines unless they are adjacent.\r\nYou may want to sort the input first, or use sort -u without uniq.\r\n\u001b]3008;end=ca443c60-5298-49f9-beb5-be9aab654e5b;exit=success\u001b\\\u001b]3008;start=36f26070-fc53-485a-b93c-55bfbb392f67;machineid=ec269368495231e336f7ec98aad6f10e;user=bandit8;hostname=gibson-0;bootid=b35b0f02-a9a4-4941-884c-a1ce6f7ec2e9;pid=00000000000000000003;type=shell;cwd=/home/bandit8\u001b\\\u001b[?2004h\u001b]0;bandit8@bandit: ~\u0007\u001b[01;32mbandit8@bandit\u001b[00m:\u001b[01;34m~\u001b[00m$ "]

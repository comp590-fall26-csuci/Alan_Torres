[1077.844213, "o", "Display sorted concatenation of all FILE(s). With no FILE, or when\r\nFILE is -, read standard input.\r\n\r\n\u001b[1m\u001b[4mUsage:\u001b[0m sort [OPTION]... [FILE]...\r\n\r\n\u001b[1m\u001b[4mArguments:\u001b[0m\r\n  [files]...  \r\n\r\n\u001b[1m\u001b[4mOptions:\u001b[0m\r\n      \u001b[1m--help\u001b[0m\r\n          Print help information.\r\n      \u001b[1m--version\u001b[0m\r\n          Print version information.\r\n      \u001b[1m--sort\u001b[0m <sort>\r\n          [possible values: general-numeric, human-numeric, month,\r\n          numeric, version, random]\r\n  \u001b[1m-h\u001b[0m, \u001b[1m--human-numeric-sort\u001b[0m\r\n          compare according to human readable sizes, eg 1M > 100k\r\n  \u001b[1m-M\u001b[0m, \u001b[1m--month-sort\u001b[0m\r\n          compare according to month name abbreviation\r\n  \u001b[1m-n\u001b[0m, \u001b[1m--numeric-sort\u001b[0m\r\n          compare according to string numerical value\r\n  \u001b[1m-g\u001b[0m, \u001b[1m--general-numeric-sort\u001b[0m\r\n          compare according to string general numerical value\r\n  \u001b[1m-V\u001b[0m, \u001b[1m--version-sort\u001b[0m\r\n          Sort by SemVer version number, eg 1.12.2 > 1.1.2\r\n  \u001b[1m-R\u001b[0m, \u001b[1m--random-sort\u001b[0m\r\n          shuffle in random order\r\n      \u001b[1m--random-source\u001b[0m <FILE>\r\n          use FILE as a source of random data\r\n  \u001b[1m-d\u001b[0m, \u001b[1m--dictionary-order\u001b[0m\r\n          consider only blanks and alphanumeric characters\r\n  \u001b[1m-m\u001b[0m, \u001b[1m--merge\u001b[0m\r\n          merge already sorted files; do not sort\r\n  \u001b[1m-c\u001b[0m, \u001b[1m--check\u001b[0m[=<check>...]\r\n          check for sorted input; do not sort [possible values:\r\n          silent, quiet, diagnose-first]\r\n  \u001b[1m-C\u001b[0m, \u001b[1m--check-silent\u001b[0m\r\n          exit successfully if the given file is already sorted, and\r\n          exit with status 1 otherwise.\r\n  \u001b[1m-f\u001b[0m, \u001b[1m--ignore-case\u001b[0m\r\n          fold lower case to upper case characters\r\n  \u001b[1m-i\u001b[0m, \u001b[1m--ignore-nonprinting\u001b[0m\r\n          ignore nonprinting characters\r\n  \u001b[1m-b\u001b[0m, \u001b[1m--ignore-leading-blanks\u001b[0m\r\n          ignore leading blanks when finding sort keys in each line\r\n  \u001b[1m-o\u001b[0m, \u001b[1m--output\u001b[0m <FILENAME>\r\n          write output to FILENAME instead of stdout\r\n  \u001b[1m-r\u001b[0m, \u001b[1m--reverse\u001b[0m\r\n          reverse the output\r\n  \u001b[1m-s\u001b[0m, \u001b[1m--stable\u001b[0m\r\n          stabilize sort by disabling last-resort comparison\r\n  \u001b[1m-u\u001b[0m, \u001b[1m--unique\u001b[0m\r\n          output only the first of an equal run\r\n  \u001b[1m-k\u001b[0m, \u001b[1m--key\u001b[0m <key>\r\n          sort by a key\r\n  \u001b[1m-t\u001b[0m, \u001b[1m--field-separator\u001b[0m <field-separator>\r\n          custom separator for -k\r\n  \u001b[1m-z\u001b[0m, \u001b[1m--zero-terminated\u001b[0m\r\n          line delimiter is NUL, not newline\r\n      \u001b[1m--parallel\u001b[0m <NUM_THREADS>\r\n          change the number of threads running concurrently to\r\n          NUM_THREADS\r\n  \u001b[1m-S\u001b[0m, \u001b[1m--buffer-size\u001b[0m <SIZE>\r\n          sets the maximum SIZE of each segment in number of sorted\r\n          items\r\n  \u001b[1m-T\u001b[0m, \u001b[1m--temporary-directory\u001b[0m <DIR>\r\n          use DIR for temporaries, not $TMPDIR or /tmp\r\n      \u001b[1m--compress-program\u001b[0m <PROG>\r\n          compress temporary files with PROG, decompress with PROG\r\n          -d; PROG has to take input from stdin and output to stdout\r\n      \u001b[1m--batch-size\u001b[0m <N_MERGE>\r\n          Merge at most N_MERGE inputs at once.\r\n      \u001b[1m--files0-from\u001b[0m <NUL_FILE>\r\n          read input from the files specified by NUL-terminated\r\n          NUL_FILE\r\n      \u001b[1m--debug\u001b[0m\r\n          underline the parts of the line that are actually used for\r\n          sorting\r\n\r\nThe key format is FIELD[.CHAR][OPTIONS][,FIELD[.CHAR]][OPTIONS].\r\n\r\nFields by default are separated by the first whitespace after a\r\nnon-whitespace character. Use -t to specify a custom separator.\r\nIn the default case, whitespace is appended at the beginning of each\r\nfield. Custom separators however are not included in fields.\r\n\r\nFIELD and CHAR both start at 1 (i.e. they are 1-indexed). If there is\r\nno end specified after a comma, the end will be the end of the line.\r\nIf CHAR is set 0, it means the end of the field. CHAR defaults to 1\r\nfor the start position and to 0 for the end position.\r\n\r\nValid options are: MbdfhnRrV. They override the global options for\r\nthis key.\r\n"]
[1077.85732, "o", "\u001b]3008;end=a35f1233-7b6d-4d52-abe8-d499f38350e4;exit=success\u001b\\\u001b]3008;start=36f26070-fc53-485a-b93c-55bfbb392f67;machineid=ec269368495231e336f7ec98aad6f10e;user=bandit8;hostname=gibson-0;bootid=b35b0f02-a9a4-4941-884c-a1ce6f7ec2e9;pid=00000000000000000003;type=shell;cwd=/home/bandit8\u001b\\\u001b[?2004h\u001b]0;bandit8@bandit: ~\u0007\u001b[01;32mbandit8@bandit\u001b[00m:\u001b[01;34m~\u001b[00m$ "]

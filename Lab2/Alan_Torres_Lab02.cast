[309.457307, "o", "\r\n\u001b[?2004l\r\u001b]3008;start=1a01f97c-e5fe-4b29-abe2-0122f8409686;machineid=ec269368495231e336f7ec98aad6f10e;user=bandit4;hostname=gibson-0;bootid=b35b0f02-a9a4-4941-884c-a1ce6f7ec2e9;pid=00000000000000000003;type=command;cwd=/home/bandit4/inhere\u001b\\Usage: file [-bcCdEhikLlNnprsSvzZ0] [--apple] [--extension] [--mime-encoding]\r\n            [--mime-type] [-e <testname>] [-F <separator>]  [-f <namefile>]\r\n            [-m <magicfiles>] [-P <parameter=value>] [--exclude-quiet]\r\n            <file> ...\r\n       file -C [-m <magicfiles>]\r\n       file [--help]\r\n\u001b]3008;end=1a01f97c-e5fe-4b29-abe2-0122f8409686;exit=failure;status=1\u001b\\\u001b]3008;start=2d3cf90e-2375-4129-bdf6-85d52b9b4be1;machineid=ec269368495231e336f7ec98aad6f10e;user=bandit4;hostname=gibson-0;bootid=b35b0f02-a9a4-4941-884c-a1ce6f7ec2e9;pid=00000000000000000003;type=shell;cwd=/home/bandit4/inhere\u001b\\\u001b[?2004h\u001b]0;bandit4@bandit: ~/inhere\u0007\u001b[01;32mbandit4@bandit\u001b[00m:\u001b[01;34m~/inhere\u001b[00m$ "]

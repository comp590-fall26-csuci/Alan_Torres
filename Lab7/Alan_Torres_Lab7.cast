[1424.911673, "o", "\u001b[H\u001b(B\u001b[0;7m  GNU nano 8.4                                                                                              playbook.yaml                                                                                                        \u001b[1;224H\u001b(B\u001b[m\r\u001b[63d\u001b(B\u001b[0;7m^G\u001b(B\u001b[m Help\u001b[63;18H\u001b(B\u001b[0;7m^O\u001b(B\u001b[m Write Out     \u001b(B\u001b[0;7m^F\u001b(B\u001b[m Where Is\u001b[52G"]
[1424.91178, "o", "\u001b(B\u001b[0;7m^K\u001b(B\u001b[m Cut\u001b[63;69H\u001b(B\u001b[0;7m^T\u001b(B\u001b[m Execute\u001b[86G\u001b(B\u001b[0;7m^C\u001b(B\u001b[m Location\u001b[103G\u001b(B\u001b[0;7mM-U\u001b(B\u001b[m Undo\u001b[63;120H\u001b(B\u001b[0;7mM-A\u001b(B\u001b[m Set Mark     \u001b(B\u001b[0;7mM-]\u001b(B\u001b[m To Bracket   \u001b(B\u001b[0;7mM-B\u001b(B\u001b[m Previous     \u001b(B\u001b[0;7m◂\u001b(B\u001b[m Back\u001b[63;188H\u001b(B\u001b[0;7m^◂\u001b(B\u001b[m Prev Word     \u001b(B\u001b[0;7m^A\u001b(B\u001b[m Home\r\u001b[64d\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Exit\u001b[64;18H\u001b(B\u001b[0;7m^R\u001b(B\u001b[m Read File     \u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Replace\u001b[52G\u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste\u001b[64;69H\u001b(B\u001b[0;7m^J\u001b(B\u001b[m Justify\u001b[86G"]
[1424.912002, "o", "\u001b(B\u001b[0;7m^/\u001b(B\u001b[m Go To Line    \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\u001b[64;120H\u001b(B\u001b[0;7mM-6\u001b(B\u001b[m Copy\u001b[64;137H\u001b(B\u001b[0;7m^B\u001b(B\u001b[m Where Was     \u001b(B\u001b[0;7mM-F\u001b(B\u001b[m Next\u001b[64;171H\u001b(B\u001b[0;7m▸\u001b(B\u001b[m Forward\u001b[64;188H\u001b(B\u001b[0;7m^▸\u001b(B\u001b[m Next Word     \u001b(B\u001b[0;7m^E\u001b(B\u001b[m End"]
[1424.91298, "o", "\r\u001b[2d\u001b(B\u001b[0;1m---\r\u001b[3d\u001b[33m- \u001b[32mname\u001b(B\u001b[0m: \u001b(B\u001b[mInstalling Gitea\u001b[4;3H\u001b(B\u001b[0;1m\u001b[32mhosts\u001b(B\u001b[0m: \u001b(B\u001b[mlocal_machine\u001b[5;3H\u001b(B\u001b[0;1m\u001b[32mbecome\u001b(B\u001b[0m: \u001b(B\u001b[0;1m\u001b[35mtrue\u001b[7;3H\u001b[32mtasks\u001b(B\u001b[0m:\r\u001b[8d\u001b(B\u001b[0;1m\u001b[33m    - \u001b[32mname\u001b(B\u001b[0m: \u001b(B\u001b[mInstalling dependencies\u001b[9;7H\u001b(B\u001b[0;1m\u001b[32mansible.builtin.apt\u001b(B\u001b[0m:\u001b[10;9H\u001b(B\u001b[0;1m\u001b[32mname\u001b(B\u001b[0m:\u001b[11;10H\u001b(B\u001b[0;1m\u001b[33m\u001b[1K - \u001b[39m\u001b(B\u001b[mgit\u001b[12;10H\u001b(B\u001b[0;1m\u001b[33m\u001b[1K - \u001b[39m\u001b(B\u001b[msqlite3\u001b[13;10H\u001b(B\u001b[0;1m\u001b[33m\u001b[1K - \u001b[39m\u001b(B\u001b[mca-certificates\u001b[14;10H"]
[1424.913112, "o", "\u001b(B\u001b[0;1m\u001b[33m\u001b[1K - \u001b[39m\u001b(B\u001b[mbuild-essential\u001b[15;9H\u001b(B\u001b[0;1m\u001b[32mstate\u001b(B\u001b[0m: \u001b(B\u001b[mpresent\u001b[16;9H\u001b(B\u001b[0;1m\u001b[32mupdate_cache\u001b(B\u001b[0m: \u001b(B\u001b[0;1m\u001b[35mtrue\r\u001b[18d\u001b[33m    - \u001b[32mname\u001b(B\u001b[0m: \u001b(B\u001b[mCreate service accounts\u001b[19;7H\u001b(B\u001b[0;1m\u001b[32mansible.builtin.user\u001b(B\u001b[0m:\u001b[20;9H\u001b(B\u001b[0;1m\u001b[32mname\u001b(B\u001b[0m: \u001b(B\u001b[0;1m\u001b[35m\"\u001b(B\u001b[0m\u001b[33m{{\u001b(B\u001b[0;1m\u001b[35m item \u001b(B\u001b[0m\u001b[33m}}\u001b(B\u001b[0;1m\u001b[35m\"\u001b[21;9H\u001b[32msystem\u001b(B\u001b[0m: \u001b(B\u001b[0;1m\u001b[35mtrue\u001b[22;9H\u001b[32mhome\u001b(B\u001b[0m: \u001b(B\u001b[0;1m\u001b[35m\"/var/lib/\u001b(B\u001b[0m\u001b[33m{{\u001b(B\u001b[0;1m\u001b[35m item \u001b(B\u001b[0m\u001b[33m}}\u001b(B\u001b[0;1m\u001b[35m\"\u001b[23;9H"]
[1424.913254, "o", "\u001b[32mshell\u001b(B\u001b[0m: \u001b(B\u001b[m/bin/bash\u001b[24;7H\u001b(B\u001b[0;1m\u001b[32mloop\u001b(B\u001b[0m:\u001b[25;8H\u001b(B\u001b[0;1m\u001b[33m\u001b[1K - \u001b[39m\u001b(B\u001b[mgitea\u001b[26;8H\u001b(B\u001b[0;1m\u001b[33m\u001b[1K - \u001b[39m\u001b(B\u001b[mgitea-runner\r\u001b[28d\u001b(B\u001b[0;1m\u001b[33m    - \u001b[32mname\u001b(B\u001b[0m: \u001b(B\u001b[mCreate configuration directories\u001b[29;7H\u001b(B\u001b[0;1m\u001b[32mansible.builtin.file\u001b(B\u001b[0m:\u001b[30;9H\u001b(B\u001b[0;1m\u001b[32mpath\u001b(B\u001b[0m: \u001b(B\u001b[0;1m\u001b[35m\"/etc/\u001b(B\u001b[0m\u001b[33m{{\u001b(B\u001b[0;1m\u001b[35m item \u001b(B\u001b[0m\u001b[33m}}\u001b(B\u001b[0;1m\u001b[35m\"\u001b[31;9H\u001b[32mstate\u001b(B\u001b[0m: \u001b(B\u001b[mdirectory\u001b[32;9H\u001b(B\u001b[0;1m\u001b[32mowner\u001b(B\u001b[0m: \u001b(B\u001b[0;1m\u001b[35m\"\u001b(B\u001b[0m\u001b[33m{{\u001b(B\u001b[0;1m\u001b[35m item \u001b(B\u001b[0m\u001b[33m}}\u001b(B\u001b[0;1m\u001b[35m\"\u001b[33;9H\u001b[32mmode\u001b(B\u001b[0m: \u001b(B\u001b[0;1m\u001b[35m\"0700\"\u001b[34;7H"]
[1424.913406, "o", "\u001b[32mloop\u001b(B\u001b[0m:\u001b[35;8H\u001b(B\u001b[0;1m\u001b[33m\u001b[1K - \u001b[39m\u001b(B\u001b[mgitea\u001b[36;8H\u001b(B\u001b[0;1m\u001b[33m\u001b[1K - \u001b[39m\u001b(B\u001b[mgitea-runner\r\u001b[38d\u001b(B\u001b[0;1m\u001b[33m    - \u001b[32mname\u001b(B\u001b[0m: \u001b(B\u001b[mDownload Gitea\u001b[39;7H\u001b(B\u001b[0;1m\u001b[32mansible.builtin.get_url\u001b(B\u001b[0m:\u001b[40;9H\u001b(B\u001b[0;1m\u001b[32murl\u001b(B\u001b[0m: \u001b(B\u001b[mhttps://dl.gitea.com/gitea/1.25.5/gitea-1.25.5-linux-amd64\u001b[41;9H\u001b(B\u001b[0;1m\u001b[32mdest\u001b(B\u001b[0m: \u001b(B\u001b[m/usr/local/bin/gitea\u001b[42;9H\u001b(B\u001b[0;1m\u001b[32mowner\u001b(B\u001b[0m: \u001b(B\u001b[mroot\u001b[43;9H\u001b(B\u001b[0;1m\u001b[32mgroup\u001b(B\u001b[0m: \u001b(B\u001b[mroot\u001b[44;9H\u001b(B\u001b[0;1m\u001b[32mmode\u001b(B\u001b[0m: \u001b(B\u001b[0;1m\u001b[35m\"0755\"\r\u001b[46d\u001b[33m    - \u001b[32mname\u001b(B\u001b[0m: \u001b(B\u001b[mCreate Gitea service\u001b[47;7H\u001b(B\u001b[0;1m\u001b[32mansible.builtin.copy\u001b(B\u001b[0m:\u001b[48;9H\u001b(B\u001b[0;1m\u001b[32mdest\u001b(B\u001b[0m: \u001b(B\u001b[m/etc/systemd/system/gitea.service\u001b[49;9H\u001b(B\u001b[0;1m\u001b[32mmode\u001b(B\u001b[0m: \u001b(B\u001b[0;1m\u001b[35m\"0644\"\u001b[50;9H"]

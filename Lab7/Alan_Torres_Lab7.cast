[1426.357358, "o", "\u001b[2;10H\u001b[1K Restart=on-failure\r\u001b[3d\u001b[K\u001b[4;10H\u001b[1K \u001b[33m[\u001b[39m\u001b(B\u001b[mInstall\u001b[33m]\u001b[39m\u001b(B\u001b[m\u001b[K\u001b[5;10H\u001b[1K WantedBy=multi-user.target\r\u001b[7d\u001b(B\u001b[0;1m\u001b[33m    - \u001b[32mname\u001b(B\u001b[0m: \u001b(B\u001b[mEnable and start Gitea\u001b[8;6H\u001b[1K \u001b(B\u001b[0;1m\u001b[32mansible.builtin.systemd_service\u001b(B\u001b[0m:\u001b[9;7H\u001b(B\u001b[m  \u001b(B\u001b[0;1m\u001b[32mname\u001b(B\u001b[0m: \u001b(B\u001b[mgitea\u001b[K\u001b[10;9H\u001b(B\u001b[0;1m\u001b[32mdaemon_reload\u001b(B\u001b[0m: \u001b(B\u001b[0;1m\u001b[35mtrue\u001b[11;8H"]
[1426.357444, "o", "\u001b[39m\u001b(B\u001b[m\u001b[1K \u001b(B\u001b[0;1m\u001b[32menabled\u001b(B\u001b[0m: \u001b(B\u001b[0;1m\u001b[35mtrue\u001b[12;8H\u001b[39m\u001b(B\u001b[m\u001b[1K \u001b(B\u001b[0;1m\u001b[32mstate\u001b(B\u001b[0m: \u001b(B\u001b[mstarted\u001b[13;5H\u001b(B\u001b[0;1m\u001b[33m- \u001b[32mname\u001b(B\u001b[0m: \u001b(B\u001b[mCreate Gitea data directory\u001b[14;6H\u001b[1K \u001b(B\u001b[0;1m\u001b[32mansible.builtin.file\u001b(B\u001b[0m:\u001b[15;9H\u001b(B\u001b[0;1m\u001b[32mpath\u001b(B\u001b[0m: \u001b(B\u001b[m/var/lib/gitea/data\u001b[16;9H\u001b(B\u001b[0;1m\u001b[32mstate\u001b(B\u001b[0m: \u001b(B\u001b[mdirectory\u001b[K\u001b[17;9H\u001b(B\u001b[0;1m\u001b[32mowner\u001b(B\u001b[0m: \u001b(B\u001b[mgitea\u001b[18;8H"]
[1426.357799, "o", "\u001b[1K \u001b(B\u001b[0;1m\u001b[32mmode\u001b(B\u001b[0m: \u001b(B\u001b[0;1m\u001b[35m\"0700\"\u001b[39m\u001b(B\u001b[m\u001b[K\r\u001b[19d\u001b[K\u001b[20d\u001b(B\u001b[0;1m\u001b[33m    - \u001b[32mname\u001b(B\u001b[0m: \u001b(B\u001b[mGenerate persistent Gitea secrets\u001b[21;7H\u001b(B\u001b[0;1m\u001b[32mansible.builtin.shell\u001b(B\u001b[0m:\u001b(B\u001b[0;1m |\u001b[22;9H\u001b(B\u001b[mumask 077\u001b[K\u001b[23;9H/usr/local/bin/gitea generate secret \u001b[33m{{\u001b[39m\u001b(B\u001b[m item \u001b[33m}}\u001b[39m\u001b(B\u001b[m > /etc/gitea/\u001b[33m{{\u001b[39m\u001b(B\u001b[m item \u001b[33m}}\u001b[24;7H\u001b(B\u001b[0;1m\u001b[32margs\u001b[25;8H"]
[1426.358101, "o", "\u001b[39m\u001b(B\u001b[m\u001b[1K \u001b(B\u001b[0;1m\u001b[32mcreates\u001b(B\u001b[0m: \u001b(B\u001b[0;1m\u001b[35m\"/etc/gitea/\u001b(B\u001b[0m\u001b[33m{{\u001b(B\u001b[0;1m\u001b[35m item \u001b(B\u001b[0m\u001b[33m}}\u001b(B\u001b[0;1m\u001b[35m\"\u001b[26;6H\u001b[39m\u001b(B\u001b[m\u001b[1K \u001b(B\u001b[0;1m\u001b[32mloop\u001b(B\u001b[0m:\u001b(B\u001b[m\u001b[K\u001b[27;8H\u001b(B\u001b[0;1m\u001b[33m\u001b[1K - \u001b[39m\u001b(B\u001b[mSECRET_KEY\u001b[28;5H\u001b(B\u001b[0;1m\u001b[33m    - \u001b[39m\u001b(B\u001b[mINTERNAL_TOKEN\u001b[K\u001b[29;7H\u001b(B\u001b[0;1m\u001b[32mno_log\u001b(B\u001b[0m: \u001b(B\u001b[0;1m\u001b[35mtrue\u001b[39m\u001b(B\u001b[m\u001b[K\r\u001b[30d\u001b[K\u001b[31d\u001b(B\u001b[0;1m\u001b[33m    - \u001b[32mname\u001b(B\u001b[0m: \u001b(B\u001b[mAllow Gitea to read its secrets\u001b[32;7H\u001b(B\u001b[0;1m\u001b[32mansible.builtin.file\u001b(B\u001b[0m:\u001b[33;9H\u001b(B\u001b[0;1m\u001b[32mpath\u001b(B\u001b[0m: \u001b(B\u001b[0;1m\u001b[35m\"/etc/gitea/\u001b(B\u001b[0m\u001b[33m{{\u001b(B\u001b[0;1m\u001b[35m item \u001b(B\u001b[0m\u001b[33m}}\u001b(B\u001b[0;1m\u001b[35m\"\u001b[34;7H\u001b[39m\u001b(B\u001b[m  \u001b(B\u001b[0;1m\u001b[32mowner\u001b(B\u001b[0m: \u001b(B\u001b[mgitea\u001b[35;8H\u001b[1K \u001b(B\u001b[0;1m\u001b[32mmode\u001b(B\u001b[0m: \u001b(B\u001b[0;1m\u001b[35m\"0600\"\u001b[36;6H\u001b[39m\u001b(B\u001b[m\u001b[1K \u001b(B\u001b[0;1m\u001b[32mloop\u001b(B\u001b[0m:\u001b(B\u001b[m\u001b[K\u001b[37;8H\u001b(B\u001b[0;1m\u001b[33m\u001b[1K - \u001b[39m\u001b(B\u001b[mSECRET_KEY\u001b[38;5H\u001b(B\u001b[0;1m\u001b[33m    - \u001b[39m\u001b(B\u001b[mINTERNAL_TOKEN\u001b[K\r\u001b[39d\u001b[K\u001b[40d"]
[1426.358245, "o", "\u001b(B\u001b[0;1m\u001b[33m    - \u001b[32mname\u001b(B\u001b[0m: \u001b(B\u001b[mConfigure Gitea\u001b[K\u001b[41;7H\u001b(B\u001b[0;1m\u001b[32mansible.builtin.copy\u001b(B\u001b[0m:\u001b(B\u001b[m\u001b[K\u001b[42;9H\u001b(B\u001b[0;1m\u001b[32mdest\u001b(B\u001b[0m: \u001b(B\u001b[m/etc/gitea/app.ini\u001b[43;9H\u001b(B\u001b[0;1m\u001b[32mowner\u001b(B\u001b[0m: \u001b(B\u001b[mgitea\u001b[44;17H\u001b(B\u001b[0;1m\u001b[35m600\u001b[45;9H\u001b[32mcontent\u001b(B\u001b[0m:\u001b(B\u001b[0;1m |\u001b[46;10H\u001b(B\u001b[m\u001b[1K APP_NAME = Lab7 Gitea\u001b[K\u001b[47;7H    RUN_USER = gitea\u001b[K\u001b[48;9H  RUN_MODE = prod\u001b[K\r\u001b[49d\u001b[K\u001b[50;9H  \u001b[33m[\u001b[39m\u001b(B\u001b[mdatabase\u001b[33m]\u001b[51;11H\u001b[39m\u001b(B\u001b[mDB_TYPE = sqlite3\u001b[52;11HPATH = /var/lib/gitea/data/gitea.db\r\u001b[53d\u001b[K\u001b[54;11H\u001b[33m[\u001b[39m\u001b(B\u001b[mrepository\u001b[33m]\u001b[55;11H\u001b[39m\u001b(B\u001b[mROOT = /var/lib/gitea/repositories\r\u001b[56d\u001b[K\u001b[57;11H\u001b[33m[\u001b[39m\u001b(B\u001b[mserver\u001b[33m]\u001b[39m\u001b(B\u001b[m\u001b[K\u001b[58;11HAPP_DATA_PATH = /var/lib/gitea/data\u001b[59;11HHTTP_ADDR = 127.0.0.1\u001b[K\u001b[60;11HHTTP_PORT = 3000\u001b[K\u001b[61;11HDOMAIN = localhost\r\u001b[2d"]

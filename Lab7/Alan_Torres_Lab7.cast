[1986.02325, "o", "\u001b[33m    - \u001b[32mname\u001b(B\u001b[0m: \u001b(B\u001b[mCreate service accounts\u001b[21;7H\u001b(B\u001b[0;1m\u001b[32mansible.builtin.user\u001b(B\u001b[0m:\u001b[22;9H\u001b(B\u001b[0;1m\u001b[32mname\u001b(B\u001b[0m: \u001b(B\u001b[0;1m\u001b[35m\"\u001b(B\u001b[0m\u001b[33m{{\u001b(B\u001b[0;1m\u001b[35m item \u001b(B\u001b[0m\u001b[33m}}\u001b(B\u001b[0;1m\u001b[35m\"\u001b[23;9H\u001b[32msystem\u001b(B\u001b[0m: \u001b(B\u001b[0;1m\u001b[35mtrue\u001b[24;9H\u001b[32mhome\u001b(B\u001b[0m: \u001b(B\u001b[0;1m\u001b[35m\"/var/lib/\u001b(B\u001b[0m\u001b[33m{{\u001b(B\u001b[0;1m\u001b[35m item \u001b(B\u001b[0m\u001b[33m}}\u001b(B\u001b[0;1m\u001b[35m\"\u001b[25;9H\u001b[32mshell\u001b(B\u001b[0m: \u001b(B\u001b[m/bin/bash\u001b[26;7H\u001b(B\u001b[0;1m\u001b[32mloop\u001b(B\u001b[0m:\u001b[27;8H\u001b(B\u001b[0;1m\u001b[33m\u001b[1K - \u001b[39m\u001b(B\u001b[mgitea\u001b[28;8H\u001b(B\u001b[0;1m\u001b[33m\u001b[1K - \u001b[39m\u001b(B\u001b[mgitea-runner\r\u001b[30d\u001b(B\u001b[0;1m\u001b[33m    - \u001b[32mname\u001b(B\u001b[0m: \u001b(B\u001b[mCreate configuration directories\u001b[31;7H\u001b(B\u001b[0;1m\u001b[32mansible.builtin.file\u001b(B\u001b[0m:\u001b[32;9H\u001b(B\u001b[0;1m\u001b[32mpath\u001b(B\u001b[0m: \u001b(B\u001b[0;1m\u001b[35m\"/etc/\u001b(B\u001b[0m\u001b[33m{{\u001b(B\u001b[0;1m\u001b[35m item \u001b(B\u001b[0m\u001b[33m}}\u001b(B\u001b[0;1m\u001b[35m\"\u001b[33;9H\u001b[32mstate\u001b(B\u001b[0m: \u001b(B\u001b[mdirectory\u001b[34;9H\u001b(B\u001b[0;1m\u001b[32mowner\u001b(B\u001b[0m: \u001b(B\u001b[0;1m\u001b[35m\"\u001b(B\u001b[0m\u001b[33m{{\u001b(B\u001b[0;1m\u001b[35m item \u001b(B\u001b[0m\u001b[33m}}\u001b(B\u001b[0;1m\u001b[35m\"\u001b[35;9H\u001b[32mmode\u001b(B\u001b[0m: \u001b(B\u001b[0;1m\u001b[35m\"0700\"\u001b[36;7H\u001b[32mloop\u001b(B\u001b[0m:\u001b[37;8H\u001b(B\u001b[0;1m\u001b[33m\u001b[1K - \u001b[39m\u001b(B\u001b[mgitea\u001b[38;8H\u001b(B\u001b[0;1m\u001b[33m\u001b[1K - \u001b[39m\u
[436.382401, "o", "\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m n <= 1:\u001b[4;9H\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m n\u001b[5;5H\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m fibonacci_recursive(n - 1) + fibonacci_recursive(n - 2)\r\u001b[8d\u001b(B\u001b[0;1m\u001b[36mwith\u001b[39m\u001b(B\u001b[m open(\u001b(B\u001b[0;1m\u001b[32m\"output/fibonacci.txt\"\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m\"w\"\u001b[39m\u001b(B\u001b[m) \u001b(B\u001b[0;1m\u001b[36mas\u001b[39m\u001b(B\u001b[m file:\u001b[9;5H\u001b(B\u001b[0;1m\u001b[36mfor\u001b[39m\u001b(B\u001b[m i \u001b(B\u001b[0;1m\u001b[36min\u001b[39m\u001b(B\u001b[m range(25):\u001b[10;9Hfile.write(str(fibonacci_recursive(i)) + \u001b(B\u001b[0;1m\u001b[32m\"\u001b(B\u001b[0m\u001b[38;5;148m\\n\u001b(B\u001b[0;1m\u001b[32m\"\u001b[39m\u001b(B\u001b[m)\u001b[?12l\u001b[?25h"]

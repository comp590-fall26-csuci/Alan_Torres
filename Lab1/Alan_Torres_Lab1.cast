[506.993267, "o", "\r\n\u001b[?2004l\r"]
[507.000853, "o", "def fibonacci_recursive(n):\r\n    if n <= 1:\r\n        return n\r\n    return fibonacci_recursive(n - 1) + fibonacci_recursive(n - 2)\r\n\r\n\r\nwith open(\"output/fibonacci.txt\", \"w\") as file:\r\n    for i in range(25):\r\n        file.write(str(fibonacci_recursive(i)) + \"\\n\")\r\n"]

[401.41919, "o", "\r\n\u001b[?2004l\r"]
[401.427412, "o", "def fibonacci_iterative(n):\r\n    a, b = 0, 1\r\n\r\n    with open(\"output/fibonacci.txt\", \"w\") as file:\r\n        for _ in range(n):\r\n            file.write(str(a) + \"\\n\")\r\n            a, b = b, a + b\r\n\r\n\r\nfibonacci_iterative(25)\r\n"]
